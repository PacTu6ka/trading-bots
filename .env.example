ARENA_TOKEN=

# Telegram polling. Set TELEGRAM_CHAT_ID for startup notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=

# Comma list: btc_bollinger,btc_trend,moex_portfolio,moex_intraday or all.
ENABLED_BOTS=btc_bollinger

# Shared RAM controls.
MARKET_DATA_MAX_BARS=600
LOG_LEVEL=INFO
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5

# Global polling fallback.
BOT_POLL_INTERVAL=60

# BTC Bollinger bot.
BTC_BOLLINGER_ENABLED=true
BTC_BOLLINGER_PORTFOLIO=btc
BTC_BOLLINGER_POLL=60
BTC_BOLLINGER_CASH_USAGE=0.99
BTC_BOLLINGER_STOP_LOSS=0.02
BTC_BOLLINGER_TAKE_PROFIT=0.03

# BTC trend/divergence bot. Disabled by default to avoid two strategies
# trading BTC at once unless explicitly enabled.
BTC_TREND_ENABLED=false
BTC_TREND_PORTFOLIO=btc trend
BTC_TREND_POLL=60
BTC_TREND_DAILY_LOSS_LIMIT_RUB=70000

# MOEX 1h portfolio bot. Disabled by default.
MOEX_PORTFOLIO_ENABLED=false
MOEX_PORTFOLIO_PORTFOLIO=saux hak
MOEX_PORTFOLIO_POLL=60
MOEX_PORTFOLIO_POSITION_RUB=200000
MOEX_PORTFOLIO_STOP_LOSS=0.03
MOEX_PORTFOLIO_TAKE_PROFIT=0.025
MOEX_PORTFOLIO_MAX_BARS=600

# MOEX 5min intraday bot. Disabled by default and heavier on RAM/network.
MOEX_INTRADAY_ENABLED=false
MOEX_INTRADAY_PORTFOLIO=saux intraday
MOEX_INTRADAY_POLL=60
MOEX_INTRADAY_POSITION_RUB=200000
MOEX_INTRADAY_STOP_LOSS=0.012
MOEX_INTRADAY_TAKE_PROFIT=0.018
MOEX_INTRADAY_MAX_BARS=1200
MOEX_INTRADAY_MAX_OPEN_POSITIONS=5
